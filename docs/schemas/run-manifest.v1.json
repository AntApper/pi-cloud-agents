{
  "$ref": "#/definitions/RunManifest",
  "definitions": {
    "RunManifest": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^run-[a-z0-9-]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "launching",
            "running",
            "idle",
            "suspended",
            "completed",
            "failed",
            "terminated"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "microvmId": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "imageVersion": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string"
            },
            "workBranch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url",
            "workBranch"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "id"
          ],
          "additionalProperties": false
        },
        "lastEntryId": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimatedCostUsd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "totalTokens"
          ],
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "properties": {
            "workBranch": {
              "type": "string",
              "minLength": 1
            },
            "lastCommit": {
              "type": "string"
            },
            "prUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "workBranch"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "continuedFrom": {
          "type": "string"
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "v",
        "runId",
        "owner",
        "status",
        "createdAt",
        "updatedAt",
        "imageVersion",
        "repo",
        "model",
        "timeline"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
