{
  "name": "pi-cloud-agents",
  "version": "0.1.0",
  "description": "Cloud agents for pi in AWS Lambda MicroVMs with rich local mirroring",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-cloud-agents": "./dist/cli/main.js"
  },
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extension/index.ts"]
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "extension/",
    "shared/",
    "dist/",
    "core/",
    "cli/",
    "runner/",
    "image/",
    "infra/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node --experimental-strip-types scripts/doc-glyph-scan.ts",
    "lint:fix": "biome check --write .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "schemas:gen": "tsx scripts/gen-schemas.ts",
    "build": "tsx scripts/build.ts",
    "prepublishOnly": "npm run check && npm run build",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "e2e:aws": "tsx scripts/e2e-aws.ts",
    "aws:cleanup": "tsx scripts/aws-cleanup.ts",
    "spike:aws-readiness": "tsx scripts/spike/aws-readiness.ts",
    "spike:credential-portability": "tsx scripts/spike/credential-portability.ts",
    "spike:hello-microvm": "tsx scripts/spike/hello-microvm.ts",
    "spike:guest-capabilities": "tsx scripts/spike/guest-capabilities.ts",
    "spike:pi-headless": "tsx scripts/spike/pi-headless.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1127.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1127.0",
    "@aws-sdk/client-iam": "^3.1127.0",
    "@aws-sdk/client-lambda-microvms": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/client-service-quotas": "^3.1127.0",
    "@aws-sdk/client-ssm": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@sinclair/typebox": "^0.34.28",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.0",
    "js-yaml": "^5.4.1",
    "tsx": "^4.23.13",
    "typebox": "^1.3.28",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yaml": "^2.9.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
